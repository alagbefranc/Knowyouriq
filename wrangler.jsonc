{
  // Cloudflare Workers configuration for KnowYourIQ (built with OpenNext).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowyouriq",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knowyouriq",
      "database_id": "b7a226a4-e598-4c5d-bb3c-24fc845d5363",
      "migrations_dir": "migrations"
    }
  ]
  // PAYMENTS_MODE is deliberately not set here: without a real payment
  // processor, checkout on the deployed site refuses instead of granting access.
}
